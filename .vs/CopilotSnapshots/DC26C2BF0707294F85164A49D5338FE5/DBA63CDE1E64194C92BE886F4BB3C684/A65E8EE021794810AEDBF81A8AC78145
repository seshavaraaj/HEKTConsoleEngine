#include "Object.h"
#include "Screen.h"
#include "Main.h"
#include <string>
#include <vector>

struct Transform
{
	float positionX = 0;
	float positionY = 0;
	float rotationZ = 0;
};

struct Sprite
{
	int width = 0;
	int height = 0;
	std::string Chars[];
};

class IObject
{
public:
	Transform transform;
	Sprite sprite;

	virtual void Render() = 0;

	int GetTransformX()
	{
		return (int)transform.positionX;
	}

	int GetTransformY()
	{
		return (int)transform.positionY;
	}

	IObject(Transform transform, Sprite sprite)
	{
		IObjects.push_back(*this);
		this->transform = transform;
		this->sprite = sprite;
	}
};