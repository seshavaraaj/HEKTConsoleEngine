#pragma once
#include <string>
#include <vector>
#include "Main.h"

struct Transform
{
    float positionX = 0;
    float positionY = 0;
    float rotationZ = 0;
};

struct Sprite
{
    int width = 0;
    int height = 0;
    std::vector<std::string> Chars;
};

class IObject
{
public:
    Transform transform;
    Sprite sprite;

    virtual void Render() = 0;

	virtual void Awake() = 0;

	virtual void Update(float deltaTime) = 0;

    int GetTransformX()
    {
        return (int)transform.positionX;
    }

    int GetTransformY()
    {
        return (int)transform.positionY;
    }

    IObject(Transform transform, Sprite sprite);
};